# 01. 外層迴圈：控制總共有 5 行（x 從 1 跑到 5）
for x in range(1, 6):
    
    # 02. 內層迴圈：控制每一行前面的「空白」數量（隨著行數增加，空白逐漸減少）
    for y in range(1, 6 - x): 
        print(' ', end='')
        
    # 03. 內層迴圈：控制每一行要印出的「星號」數量（幾行就印幾個星號）
    for y in range(1, x + 1): 
        print('*', end='')
        
    # 04. 換行指令：當某一行的空白跟星號都印完後，強迫游標跳到下一行
print()

# 05. 結尾空行：整個三角形印完後，在最下方多印一個空白
# 行（可有可無）
